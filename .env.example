# Veyra — example environment. Copy to .env and fill in the blanks.
# Never commit real secrets. Generate APP_KEY with `php artisan key:generate`.

APP_NAME=Veyra
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://veyra.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Veyra
VEYRA_EDITION=community
# Public URL of the source code you run (AGPL-3.0 section 13).
VEYRA_SOURCE_URL=https://github.com/romainalcon/veyra
# Bearer token for detailed /health output (generate with: openssl rand -hex 32).
VEYRA_HEALTH_TOKEN=
VEYRA_REGISTRATION_ENABLED=true
VEYRA_LANDING_PAGE=false
VEYRA_INVITATION_TTL_HOURS=168
VEYRA_INVITATIONS_PER_HOUR=20
# Comma-separated e-mails allowed to open /horizon outside local env.
VEYRA_ADMIN_EMAILS=

# HTTP probes. Loopback, link-local and metadata ranges are always blocked.
VEYRA_PROBES_ALLOW_PRIVATE_NETWORKS=false
VEYRA_PROBES_ALLOWED_PORTS=80,443,8080,8443
VEYRA_PROBES_TCP_ALLOWED_PORTS=22,25,80,443,465,587,993,995,3306,5432,6379
VEYRA_MONITORS_PER_HOUR=30
VEYRA_API_REQUESTS_PER_MINUTE=120
VEYRA_API_REQUESTS_PER_MINUTE_PER_IP=600
# Raw check retention (daily aggregates are kept) and incident reminder delay.
VEYRA_CHECK_RETENTION_DAYS=30
VEYRA_REMINDER_AFTER_MINUTES=30
VEYRA_MAINTENANCE_MAX_HOURS=168
# TLS certificate expiry warnings for HTTPS monitors, in days before expiry.
VEYRA_CERTIFICATE_WARNING_DAYS=14,7,1
# Heartbeat confirmation: missed pings before DOWN, pings before UP.
VEYRA_HEARTBEAT_DOWN_AFTER_MISSES=1
VEYRA_HEARTBEAT_UP_AFTER_PINGS=1
# DNS monitors: resolvers organizations may choose (subset of system,cloudflare,google,quad9)
# and their confirmation thresholds (default: the HTTP/TCP ones).
VEYRA_DNS_RESOLVERS=system,cloudflare,google,quad9
VEYRA_DNS_DOWN_AFTER_FAILURES=3
VEYRA_DNS_UP_AFTER_SUCCESSES=2
# Domain registration expiry of HTTP and DNS monitors (RDAP, at most daily).
VEYRA_DOMAIN_EXPIRY_ENABLED=true

# MariaDB 11.4+ (Laravel "mysql" driver)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=veyra
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production (HTTPS).
SESSION_SECURE_COOKIE=

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Horizon worker sizing
HORIZON_PROBES_MAX_PROCESSES=3
HORIZON_INCIDENTS_MAX_PROCESSES=1
HORIZON_NOTIFICATIONS_MAX_PROCESSES=1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="veyra@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Reverb — generate random values for REVERB_APP_KEY / REVERB_APP_SECRET.
REVERB_APP_ID=veyra
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
