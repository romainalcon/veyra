# Veyra — Docker Compose environment. Copy to `.env.docker` at the repository
# root and fill in every secret. Never commit the filled-in file.

# Published images: ghcr.io/<owner>/veyra-app:<version>. Leave the prefix at
# "veyra" and run `docker compose build` to build locally.
VEYRA_IMAGE_PREFIX=veyra
VEYRA_VERSION=local

APP_NAME=Veyra
APP_ENV=production
APP_DEBUG=false
# Generate with: docker compose run --rm --no-deps app php artisan key:generate --show
APP_KEY=
APP_URL=http://localhost:8000

VEYRA_SOURCE_URL=
VEYRA_HEALTH_TOKEN=

LOG_CHANNEL=stderr
LOG_LEVEL=warning

VEYRA_REGISTRATION_ENABLED=true
VEYRA_ADMIN_EMAILS=

# HTTP probes. Loopback, link-local and metadata ranges are always blocked.
VEYRA_PROBES_ALLOW_PRIVATE_NETWORKS=false
VEYRA_PROBES_ALLOWED_PORTS=80,443,8080,8443
VEYRA_MONITORS_PER_HOUR=30
# Raw check retention (daily aggregates are kept) and incident reminder delay.
VEYRA_CHECK_RETENTION_DAYS=30
VEYRA_REMINDER_AFTER_MINUTES=30

DB_DATABASE=veyra
DB_USERNAME=veyra
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_SECURE_COOKIE=false

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=veyra@example.com
MAIL_FROM_NAME=Veyra

# Random values, e.g. `openssl rand -hex 16`.
REVERB_APP_ID=veyra
REVERB_APP_KEY=
REVERB_APP_SECRET=

# Browser-facing WebSocket endpoint (through the `web` service). These are
# baked into the front-end at image build time.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8000
VITE_REVERB_SCHEME=http
